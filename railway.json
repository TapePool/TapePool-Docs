{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "echo 'Serving the committed index.html: it is built and checked locally with node build.mjs'"
  },
  "deploy": {
    "startCommand": "node preview.mjs",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
